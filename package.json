{
  "name": "flowscribe",
  "version": "0.1.0",
  "description": "Adaptive short-form literary platform with personalized narrative experience",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/queues/worker.ts",
    "start:all": "concurrently -n server,worker -c cyan,yellow \"npm run dev\" \"npm run worker\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate-v2": "tsx src/db/migrate_v2.ts",
    "test:dev": "tsx scripts/test_runner.ts dev",
    "test:holdout": "tsx scripts/test_runner.ts holdout",
    "test:smoke": "tsx scripts/test_runner.ts smoke",
    "test:full": "tsx scripts/test_runner.ts full",
    "gen:validate": "tsx scripts/gen_validate.ts",
    "diagnose": "tsx tools/diagnose.ts",
    "lint": "eslint public/js/",
    "lint:fix": "eslint public/js/ --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.645.0",
    "@types/multer": "^2.1.0",
    "bullmq": "^5.13.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "google-auth-library": "^10.6.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "marked": "^4.3.0",
    "multer": "^2.1.1",
    "openai": "^4.67.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}