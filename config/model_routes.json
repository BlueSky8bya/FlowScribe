{
  "$schema_comment": "Phase 4.12 Model Routing Configuration. router는 ${ENV_VAR} 형태를 process.env에서 치환한다. R5B-4d (2026-05-02): production active_route를 openai_renderer로 전환 — 100ep TEST2G actual PASS 입증. baseline_local은 fallback. FINAL (2026-05-02): 미사용 route_set 제거 (deepseek_*, high_quality_ensemble, gemma3_*_local, gemini_renderer) — production 사용 route(openai_renderer + baseline_local fallback)만 유지.",
  "active_route": "openai_renderer",
  "fallback_route": "baseline_local",

  "route_sets": {
    "baseline_local": {
      "description": "Fallback route — OpenAI 장애 시 안전망 (ollama + gemini narrative_repair)",
      "routes": {
        "world_setting_suggest":   { "provider": "ollama", "model": "${SUGGEST_MODEL:-gemma3:12b}", "temperature": 0.7 },
        "rules_suggest":           { "provider": "ollama", "model": "${SUGGEST_MODEL:-gemma3:12b}", "temperature": 0.7 },
        "mood_suggest":            { "provider": "ollama", "model": "${SUGGEST_MODEL:-gemma3:12b}", "temperature": 0.7 },
        "character_suggest":       { "provider": "ollama", "model": "${SUGGEST_MODEL:-gemma3:12b}", "temperature": 0.7 },
        "item_detail_suggest":     { "provider": "ollama", "model": "${SUGGEST_MODEL:-gemma3:12b}", "temperature": 0.7 },
        "style_direction_suggest": { "provider": "ollama", "model": "${SUGGEST_MODEL:-gemma3:12b}", "temperature": 0.7 },

        "planner":  { "provider": "ollama", "model": "${PLANNER_MODEL:-qwen2.5:14b}",  "temperature": 0.4, "json_mode": true },
        "renderer": { "provider": "ollama", "model": "${RENDERER_MODEL:-qwen2.5:14b}", "temperature": 0.7 },
        "state_extractor":  { "provider": "ollama", "model": "${SUMMARY_MODEL:-gemma3:12b}", "temperature": 0.2, "json_mode": true },

        "summary_writer":      { "provider": "ollama", "model": "${SUMMARY_MODEL:-gemma3:12b}", "temperature": 0.3 },
        "arc_summary_writer":  { "provider": "ollama", "model": "${SUMMARY_MODEL:-gemma3:12b}", "temperature": 0.3 },
        "foreshadow_reasoning":{ "provider": "ollama", "model": "${SUMMARY_MODEL:-gemma3:12b}", "temperature": 0.2 },
        "item_description":    { "provider": "ollama", "model": "${SUGGEST_MODEL:-gemma3:12b}", "temperature": 0.6 },

        "narrative_repair":    { "provider": "gemini", "model": "gemini-2.5-flash", "temperature": 0.1 },
        "post_validator":      { "provider": "ollama", "model": "${SUMMARY_MODEL:-gemma3:12b}", "temperature": 0.2 },
        "post_revision":       { "provider": "ollama", "model": "${RENDERER_MODEL:-qwen2.5:14b}", "temperature": 0.5 }
      },
      "multi_routes": {
        "reader_immersion_judge": [
          { "provider": "gemini", "model": "gemini-2.5-flash", "temperature": 0.1 },
          { "provider": "openai", "model": "${OPENAI_JUDGE_MODEL:-gpt-4.1-mini}", "temperature": 0.1 }
        ]
      }
    },

    "openai_renderer": {
      "description": "Production active route — Planner + Renderer + Repair 모두 OpenAI gpt-4.1-mini (R5B-4c 100ep PASS, R6 60ep multi-genre PASS).",
      "routes": {
        "planner":  { "provider": "openai", "model": "${OPENAI_PLANNER_MODEL:-gpt-4.1-mini}", "temperature": 0.4, "json_mode": true },
        "renderer": { "provider": "openai", "model": "${OPENAI_RENDERER_MODEL:-gpt-4.1-mini}", "temperature": 0.7 },
        "narrative_repair": { "provider": "openai", "model": "${OPENAI_REPAIR_MODEL:-gpt-4.1-mini}", "temperature": 0.1 }
      }
    }
  }
}
